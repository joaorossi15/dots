! X colors.
! Generated by 'wal'
*foreground:        #e3e4c8
*background:        #1d1310
*.foreground:       #e3e4c8
*.background:       #1d1310
emacs*foreground:   #e3e4c8
emacs*background:   #1d1310
URxvt*foreground:   #e3e4c8
XTerm*foreground:   #e3e4c8
UXTerm*foreground:  #e3e4c8
URxvt*background:   [100]#1d1310
XTerm*background:   #1d1310
UXTerm*background:  #1d1310
URxvt*cursorColor:  #e3e4c8
XTerm*cursorColor:  #e3e4c8
UXTerm*cursorColor: #e3e4c8
URxvt*borderColor:  [100]#1d1310

! Colors 0-15.
*.color0: #1d1310
*color0:  #1d1310
*.color1: #986128
*color1:  #986128
*.color2: #A36E3D
*color2:  #A36E3D
*.color3: #728B58
*color3:  #728B58
*.color4: #9F9961
*color4:  #9F9961
*.color5: #D6AF45
*color5:  #D6AF45
*.color6: #B4BA91
*color6:  #B4BA91
*.color7: #e3e4c8
*color7:  #e3e4c8
*.color8: #9e9f8c
*color8:  #9e9f8c
*.color9: #986128
*color9:  #986128
*.color10: #A36E3D
*color10:  #A36E3D
*.color11: #728B58
*color11:  #728B58
*.color12: #9F9961
*color12:  #9F9961
*.color13: #D6AF45
*color13:  #D6AF45
*.color14: #B4BA91
*color14:  #B4BA91
*.color15: #e3e4c8
*color15:  #e3e4c8

! Black color that will not be affected by bold highlighting.
*.color66: #1d1310
*color66:  #1d1310

! Xclock colors.
XClock*foreground: #e3e4c8
XClock*background: #1d1310
XClock*majorColor:  rgba:e3/e4/c8/ff
XClock*minorColor:  rgba:e3/e4/c8/ff
XClock*hourColor:   rgba:e3/e4/c8/ff
XClock*minuteColor: rgba:e3/e4/c8/ff
XClock*secondColor: rgba:e3/e4/c8/ff

! Set depth to make transparency work.
URxvt*depth: 32
